# Backend local-development example. Generate independent secrets in the developer's local .env.
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/campusswap
JWT_SECRET=replace-with-at-least-64-random-characters
OTP_PEPPER=replace-with-a-different-64-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
FRONTEND_URL=http://localhost:5173
TRUST_PROXY_HOPS=0

ALLOWED_COLLEGE_DOMAINS=satiengg.in
INSTITUTION_EMAIL_PATTERN=^[a-z]+[0-9]{2}(cs|bc|ai|ds|it|iot|ec|ce|me|ee)[0-9]{3}@satiengg\.in$
ENROLLMENT_PATTERN=^0108(cs|bc|ai|ds|it|iot|ec|ce|me|ee)[0-9]{2}(10|11)[0-9]{2}$
INSTITUTION_DEPARTMENTS=CSE,IT,EC,ME,CIVIL
INSTITUTION_BRANCHES=cs,bc,ai,ds,it,iot,ec,ce,me,ee
INSTITUTION_CLUBS=Coding,Robotics,Cultural,Sports
INSTITUTION_SEMESTERS=1,2,3,4,5,6,7,8

EMAIL_PROVIDER=gmail
GMAIL_USER=your-account@gmail.com
GMAIL_APP_PASSWORD=replace-with-a-16-character-google-app-password
OTP_MOCK_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=CampusSwap <your-account@gmail.com>
RESEND_TEST_MODE=false
RESEND_TEST_RECIPIENT=delivered@resend.dev
RESEND_DOMAIN_VERIFIED=false
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Product images (backend-only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
PRODUCT_IMAGE_MAX_COUNT=5
PRODUCT_IMAGE_MAX_SIZE_MB=5
SEED_ON_STARTUP=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=CampusSwap Admin
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

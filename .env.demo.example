# Use only in a dedicated same-origin demo service and database.
NODE_ENV=production
SERVE_FRONTEND=true
CAMPUSSWAP_DEMO_MODE=true
EMAIL_PROVIDER=disabled
OTP_MOCK_ENABLED=false
RESEND_TEST_MODE=false
CAMPUS_ISSUE_PRIVATE_EVIDENCE_ENABLED=false
ADMIN_BOOTSTRAP_ENABLED=false
SEED_ON_STARTUP=false
PILOT_MODE_ENABLED=false
# Exact public HTTPS origin and verified ingress hop count.
FRONTEND_URL=https://demo.example
TRUST_PROXY_HOPS=1
# Use the provider secret store and credentials scoped to the dedicated database.
MONGO_URI=
JWT_SECRET=
OTP_PEPPER=

ARG NODE_BUILD_IMAGE=node:22-alpine@sha256:1314fb30ec37592d5845e5a160d522c0e680972aa534549940b8d73bde88481a

FROM ${NODE_BUILD_IMAGE} AS frontend
WORKDIR /frontend
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
ENV VITE_API_BASE_URL=/api
RUN npm run build

FROM ${NODE_BUILD_IMAGE} AS backend-dependencies
WORKDIR /app
COPY backend/package*.json ./
RUN npm ci --omit=dev

FROM alpine:3.24@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf
RUN apk add --no-cache ca-certificates libstdc++ \
    && addgroup -g 1000 node \
    && adduser -D -u 1000 -G node node
COPY --from=backend-dependencies /usr/local/bin/node /usr/local/bin/docker-entrypoint.sh /usr/local/bin/
ENV NODE_ENV=production SERVE_FRONTEND=true
WORKDIR /app
COPY --from=backend-dependencies --chown=node:node /app/node_modules ./node_modules
COPY --chown=node:node backend/ ./
COPY --from=frontend --chown=node:node /frontend/dist/ ./public/
USER node
ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["node", "server.js"]

FROM node:22-alpine AS frontend
WORKDIR /frontend
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
ENV VITE_API_BASE_URL=/api
RUN npm run build

FROM node:22-alpine AS backend-dependencies
WORKDIR /app
COPY backend/package*.json ./
RUN npm ci --omit=dev

FROM node:22-alpine
ENV NODE_ENV=production SERVE_FRONTEND=true
WORKDIR /app
COPY --from=backend-dependencies --chown=node:node /app/node_modules ./node_modules
COPY --chown=node:node backend/ ./
COPY --from=frontend --chown=node:node /frontend/dist/ ./public/
USER node
CMD ["node", "server.js"]

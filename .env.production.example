# Production Compose overlay template. Use independently generated secret values in .env.production.
JWT_SECRET=replace-with-a-cryptographically-random-64-character-secret
OTP_PEPPER=replace-with-a-different-cryptographically-random-64-character-secret
OTP_MOCK_ENABLED=false
MONGO_ROOT_USERNAME=replace-with-root-username
MONGO_ROOT_PASSWORD=replace-with-random-root-password
MONGO_APP_USERNAME=campusswap-app
MONGO_APP_PASSWORD=replace-with-random-application-password
# URL-encode the application password when constructing this URI.
MONGO_URI=mongodb://campusswap-app:URL_ENCODED_PASSWORD@mongodb:27017/campusswap?authSource=campusswap
EMAIL_PROVIDER=resend
GMAIL_USER=
GMAIL_APP_PASSWORD=
RESEND_API_KEY=
EMAIL_FROM=CampusSwap <no-reply@satiengg.in>
RESEND_DOMAIN_VERIFIED=true
RESEND_TEST_MODE=false
RESEND_TEST_RECIPIENT=delivered@resend.dev
FRONTEND_URL=https://campusswap.example
# External TLS ingress plus frontend Nginx: verify the real hop count before deployment.
TRUST_PROXY_HOPS=2
FRONTEND_PORT=8080
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-backend-api-key
CLOUDINARY_API_SECRET=replace-with-backend-api-secret
PRODUCT_IMAGE_MAX_COUNT=5
PRODUCT_IMAGE_MAX_SIZE_MB=5
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=CampusSwap Admin
ADMIN_BOOTSTRAP_ENABLED=false
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
# Optional controlled-pilot registration gate. Keep disabled until the private
# allowlist is supplied through the deployment secret store.
PILOT_MODE_ENABLED=false
PILOT_ALLOWED_EMAILS=
ALLOWED_COLLEGE_DOMAINS=satiengg.in
INSTITUTION_EMAIL_PATTERN=^[a-z]+[0-9]{2}(cs|bc|ai|ds|it|iot|ec|ce|me|ee)[0-9]{3}@satiengg\.in$
ENROLLMENT_PATTERN=^0108(cs|bc|ai|ds|it|iot|ec|ce|me|ee)[0-9]{2}(10|11)[0-9]{2}$
INSTITUTION_DEPARTMENTS=CSE,IT,EC,ME,CIVIL
INSTITUTION_BRANCHES=cs,bc,ai,ds,it,iot,ec,ce,me,ee
INSTITUTION_CLUBS=Coding,Robotics,Cultural,Sports
INSTITUTION_SEMESTERS=1,2,3,4,5,6,7,8
